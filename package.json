    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stylusnexus/todo-sync-flow.git"
  },
  "homepage": "https://stylusnexus.github.io/todo-sync-flow/"
}
